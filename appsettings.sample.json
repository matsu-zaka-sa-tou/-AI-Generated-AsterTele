{
  "Sip": {
    "ListenAddress": "0.0.0.0",
    "SipPort": 5060,
    "AdvertisedAddress": "YOUR_PUBLIC_IP",
    "AdvertisedPort": 5060,
    "Realm": "asterisk",
    "RegisterExpiry": 3600,
    "DnsServer": "YOUR_DNS_SERVER",
    "Extensions": [
      {
        "Number": "8001",
        "Password": "CHANGE_ME_8001",
        "DisplayName": "Extension 8001",
        "Context": "internal"
      },
      {
        "Number": "8002",
        "Password": "CHANGE_ME_8002",
        "DisplayName": "Extension 8002",
        "Context": "internal"
      },
      {
        "Number": "8003",
        "Password": "CHANGE_ME_8003",
        "DisplayName": "Extension 8003",
        "Context": "internal"
      }
    ],
    "Trunks": [
      {
        "Name": "default-trunk",
        "Registrar": "sip:YOUR_SIP_REGISTRAR:5060",
        "ClientUri": "sip:YOUR_TRUNK_NUMBER@YOUR_SIP_DOMAIN",
        "FromUser": "YOUR_TRUNK_NUMBER",
        "FromDomain": "YOUR_SIP_DOMAIN",
        "ContactUser": "YOUR_TRUNK_NUMBER",
        "OutboundAddress": "YOUR_OUTBOUND_IP",
        "OutboundPort": 5060,
        "Username": "YOUR_TRUNK_NUMBER@YOUR_SIP_DOMAIN",
        "Password": "CHANGE_ME_TRUNK_PASSWORD",
        "RegisterExpiry": 1800,
        "Enabled": true
      }
    ],
    "DialRoutes": [
      {
        "Prefix": "9",
        "TrunkName": "default-trunk",
        "StripPrefix": true,
        "Enabled": true
      }
    ],
    "CallForwardRules": [
      {
        "Extension": "8001",
        "ForwardType": "Unconditional",
        "Target": "8002",
        "NoAnswerTimeout": 15,
        "Enabled": false
      }
    ],
    "DidMappings": [
      {
        "DidNumber": "YOUR_DID_NUMBER",
        "MappingType": "Direct",
        "TargetExtension": "8001"
      }
    ],
    "Runtime": {
      "MaxForwardDepth": 5,
      "RegistrationCleanupIntervalSeconds": 60,
      "SessionCleanupIntervalSeconds": 30,
      "StaleSessionTimeoutSeconds": 90,
      "MaxCallDurationHours": 2,
      "ByeRetransmitIntervalSeconds": 5,
      "ByeMaxRetransmitCount": 3,
      "ByeForcedCleanupSeconds": 20,
      "OkRetransmitMaxCount": 11,
      "MaxForwards": 70,
      "TrunkRefreshThresholdSeconds": 120,
      "TrunkRefreshInitialDelaySeconds": 10,
      "TrunkRefreshIntervalSeconds": 60,
      "StatusMonitorIntervalMs": 15000
    },
    "Rtp": {
      "PortRangeStart": 10000,
      "PortRangeEnd": 60000,
      "BindAddress": "0.0.0.0",
      "MediaAddress": "YOUR_LOCAL_IP",
      "JitterBufferMs": 60,
      "DefaultPayloadType": 8
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
